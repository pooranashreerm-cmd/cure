# Curevia Environment Configuration

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/curevia?schema=public"

# Authentication & JWT
JWT_SECRET="curevia_super_secret_jwt_key_change_in_production_2026"
JWT_REFRESH_SECRET="curevia_refresh_secret_token_key_change_in_production"
JWT_EXPIRATION="7d"
JWT_REFRESH_EXPIRATION="30d"

# Real SMS Provider Configuration (Twilio / Fast2SMS / MSG91)
# 1. Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# 2. Fast2SMS (India Gateway)
FAST2SMS_API_KEY=""

# 3. MSG91 (India Gateway)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
SMS_SENDER_ID="CUREVIA"

# Generic SMS / OTP Provider Key
SMS_PROVIDER_KEY=""
OTP_PROVIDER_KEY=""

# AI Voice Calls & Push Notifications
VOICE_PROVIDER_KEY=""
PUSH_NOTIFICATION_KEY=""
GEMINI_API_KEY=""

# Location & Maps
MAP_API_KEY=""

# Redis Cache & Background Jobs
REDIS_URL="redis://localhost:6379"

# Object Storage for Medical EHR Documents
STORAGE_BUCKET="curevia-ehr-vault"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="ap-south-1"

# Application URL
APP_URL="http://localhost:3000"
NODE_ENV="development"
